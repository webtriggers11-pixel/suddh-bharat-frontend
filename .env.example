# Copy to .env.local and fill for your environment. Nothing here is a secret
# except REVALIDATE_SECRET.

# Backend API base URL (catalog, auth, cart, checkout).
NEXT_PUBLIC_API_URL=http://localhost:3001

# The public URL this deployment actually serves on — no trailing slash.
# Defaults to the canonical URL in app/config/seo.json when unset.
#
# This is not cosmetic. It sets `metadataBase`, every absolute URL in
# sitemap.xml, and — since FEAT-027 — whether robots.txt allows indexing at
# all: a request whose host does not match this value gets `Disallow: /`, so
# preview deployments cannot compete with production in search.
#
# So SET IT on every deployment that should be indexed, including a Railway
# host before a custom domain is attached (e.g.
# https://shuddha-production.up.railway.app). Leaving it unset on a non-canonical
# host means that deployment will not be crawled. `www.` is ignored on both
# sides, so apex and www are interchangeable.
NEXT_PUBLIC_SITE_URL=

# Shared secret the backend uses to bust the Next Data Cache after admin writes
# and paid orders. Must match REVALIDATE_SECRET in the backend .env.
REVALIDATE_SECRET=
